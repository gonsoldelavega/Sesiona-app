# Copia este archivo a .env y rellena los valores.

# PocketBase (instancia autoalojada)
PB_URL=http://127.0.0.1:8090
# Credenciales de un usuario admin (superusuario) de PocketBase
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=pon_aqui_tu_password_admin

# Id del registro del profesional en la colección "users" de PocketBase.
# El bot gestiona la agenda (clients/sessions) de ESTE usuario.
SESIONA_USER_ID=pon_aqui_el_id_del_usuario

# Zona horaria para formatear fechas y para el temporizador
TZ=Atlantic/Canary

# Cuántas horas antes de la cita se envía el recordatorio
REMIND_HOURS=24

# Cada cuánto revisa citas pendientes de recordatorio (formato cron)
POLL_CRON=*/5 * * * *

# Prefijo de país por defecto si el teléfono del cliente tiene 9 dígitos
COUNTRY_PREFIX=34

# Carpeta donde se guarda la sesión de WhatsApp (debe persistir entre reinicios)
AUTH_DIR=./auth
