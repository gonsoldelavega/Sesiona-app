# Copia este archivo a .env y rellena los valores.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://jpbvzpqyclowepfziihn.supabase.co
# OJO: usa la "service_role" key (secreta, solo en el servidor). NUNCA la pongas en el navegador ni en git.
SUPABASE_SERVICE_ROLE_KEY=pon_aqui_tu_service_role_key

# Zona horaria para formatear fechas y para el temporizador
TZ=Atlantic/Canary

# Cuántas horas antes de la cita se envía el recordatorio
REMIND_HOURS=24

# Cada cuánto revisa citas pendientes de recordatorio (formato cron)
POLL_CRON=*/5 * * * *

# Prefijo de país por defecto si el teléfono del cliente tiene 9 dígitos
COUNTRY_PREFIX=34

# Carpeta donde se guarda la sesión de WhatsApp (debe persistir entre reinicios)
AUTH_DIR=./auth
